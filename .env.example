# 复制为 .env.local 或 .env.docker 使用；实际值由 .gitignore 忽略，不提交到仓库。
DJANGO_SECRET_KEY=replace-with-a-random-secret
DEBUG=false
ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=itxia
POSTGRES_USER=itxia
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# 兼容 OpenAI embeddings 协议的服务；base URL 包含 /v1（如服务需要）。
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_REVISION=local-v1
EMBEDDING_API_KEY=
# 按模型说明设置 query 指令；无要求时留空。更改后须重新导入。
EMBEDDING_QUERY_PREFIX=
# 原文预处理的完整 embedding 文本字节预算；目标模型 tokenizer 可在组合根替换。
PREPROCESS_MAX_INPUT_BYTES=2400
